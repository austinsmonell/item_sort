<mujoco model="item_sort">
  <!-- Overhead 3-axis sorting gantry over a 4 ft square walled platform.

       X   axis: a bridge carriage that spans the platform in y and slides in x.
       Y   axis: a smaller carriage that rides along the bridge in y.
       Jaw axis: a slide along the (1,1) diagonal that carries the second of two
                 L brackets toward or away from the first, opening and closing
                 the pocket between them.

       All three are modeled as DIRECT LINEAR ACTUATORS -- a <motor> on a slide
       joint, force in N. There is deliberately no motor, gear, belt or leadscrew
       geometry: on real hardware that drivetrain sits between the controller and
       the axis, but from the controller's point of view an axis is "commanded
       force -> motion", which is exactly what these three joints are. The motor
       and its gearing live in item_sort_config as a torque/rpm conversion, not
       as bodies here. What the drivetrain *does* cost the controller is friction
       and reflected inertia, and both are modeled: every joint has viscous
       `damping`, dry `frictionloss` (config.AXIS_FRICTION, live-tunable from the
       GUI) and an `armature`.

       The only parts of the gantry that touch anything are the two brackets
       under the carriage. Each is a right angle of 1/4 in stock -- a plate
       normal to x and a plate normal to y -- and they face each other across the
       diagonal, so their four plates enclose a square pocket. Closing the jaw
       squeezes a box into bracket A's corner; opening it releases. Since a plate
       pushes off either face, the pair also shoves in +/-x and +/-y with the jaw
       parked, so the machine can still work a box without gripping it. Both
       brackets reach from just above the platform surface up past the top of a
       box, so a box slides rather than tips. Every other gantry geom has
       contype/conaffinity = 0 (class "gantry"), so the bridge and rails pass
       over the boxes.

       Several dimensions here are live model fields the GUI writes at runtime
       rather than fixed geometry -- bracket width, box masses, box/platform
       friction, joint frictionloss. The values in this file are the startup
       defaults from item_sort_config; see ItemSortSim for the setters. -->
  <compiler angle="radian"/>
  <!-- timestep = 1/SIM_HZ (1000 Hz). main also sets this in code so the PID
       (100 Hz) lands on whole step counts. It is this fine because the blade is
       only 1/4 in thick: a coarser step lets it tunnel into a box face. -->
  <option timestep="0.001" gravity="0 0 -9.81" integrator="implicitfast"/>
  <!-- The two brackets never touch each other -- config asserts
       BRACKET_WIDTH_MAX <= JAW_OPENING_MIN, i.e. the jaw's stop comes before
       their arms could cross -- so no contact exclusion is needed between them,
       and any bracket-on-bracket contact that did appear would be a bug. -->

  <default>
    <geom friction="0.5 0.005 0.0001" rgba="0.60 0.60 0.65 1"/>
    <joint limited="true"/>
    <motor gear="1"/>
    <!-- Non-colliding structure: rails, bridge beam, carriage body. -->
    <default class="gantry">
      <geom contype="0" conaffinity="0" rgba="0.30 0.33 0.40 1"/>
    </default>
    <!-- One class per box size, so the pool bodies below are one line each and
         a size is changed in exactly one place. All three are 5 in tall
         (half 0.0635) and differ only in footprint: 3 / 6 / 12 in square. -->
    <default class="box">
      <geom type="box" friction="0.5 0.005 0.0001"/>
      <default class="small">
        <geom size="0.0381 0.0381 0.0635" mass="0.20" rgba="0.80 0.28 0.25 1"/>
      </default>
      <default class="medium">
        <geom size="0.0762 0.0762 0.0635" mass="0.70" rgba="0.25 0.38 0.80 1"/>
      </default>
      <default class="large">
        <geom size="0.1524 0.1524 0.0635" mass="2.50" rgba="0.30 0.62 0.36 1"/>
      </default>
    </default>
  </default>

  <visual>
    <headlight diffuse="0.5 0.5 0.5" ambient="0.3 0.3 0.3"/>
  </visual>

  <worldbody>
    <light pos="0 0 2.5" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <geom name="ground" type="plane" pos="0 0 -0.05" size="0 0 0.1"
          rgba="0.82 0.82 0.84 1"/>

    <!-- ===================== PLATFORM ===================== -->
    <!-- Work surface top is z = 0; all planar geometry in item_sort_config is
         expressed in this frame. The usable square is 4 ft x 4 ft, i.e. half
         extent 0.6096 m, bounded exactly by the inner faces of the lip below.
         The slab is 20 mm oversize on each side so the lip has something to
         stand on. -->
    <geom name="platform" type="box" pos="0 0 -0.025" size="0.6296 0.6296 0.025"
          rgba="0.72 0.70 0.66 1"/>

    <!-- Perimeter lip so a stray box cannot leave the platform. Inner faces at
         |x| = |y| = 0.6096; the axis travel limits keep the brackets clear of
         them at any width and any jaw offset. 60 mm tall -- enough to stop a
         sliding box without fouling the brackets, whose undersides are at
         z = 0.004. -->
    <geom name="wall_xp" type="box" pos=" 0.6196 0      0.03" size="0.01 0.6296 0.03"
          rgba="0.55 0.53 0.50 1"/>
    <geom name="wall_xn" type="box" pos="-0.6196 0      0.03" size="0.01 0.6296 0.03"
          rgba="0.55 0.53 0.50 1"/>
    <geom name="wall_yp" type="box" pos=" 0      0.6196 0.03" size="0.6296 0.01 0.03"
          rgba="0.55 0.53 0.50 1"/>
    <geom name="wall_yn" type="box" pos=" 0     -0.6196 0.03" size="0.6296 0.01 0.03"
          rgba="0.55 0.53 0.50 1"/>

    <!-- ===================== GANTRY ===================== -->
    <!-- Static side rails the bridge would ride on (cosmetic). -->
    <geom name="rail_yp" class="gantry" type="box" pos="0  0.65 0.162" size="0.52 0.015 0.015"/>
    <geom name="rail_yn" class="gantry" type="box" pos="0 -0.65 0.162" size="0.52 0.015 0.015"/>

    <!-- X axis: bridge carriage spanning the platform in y, sliding in x.
         Ride height 0.162 puts its underside at 0.147, clear of a 5 in box
         (0.127 tall), so stock passes under the bridge.
         Travel limit 0.44 < platform half (0.6096) - how far the tool reaches
         from the carriage centre at its worst case (config.TOOL_REACH, 0.1665,
         which is half the widest jaw opening plus the stock thickness), so the
         brackets never reach the lip at any width or offset. -->
    <body name="bridge" pos="0 0 0.162">
      <joint name="axis_x" type="slide" axis="1 0 0" range="-0.44 0.44"
             damping="12" frictionloss="1.5" armature="1.0"/>
      <geom class="gantry" type="box" size="0.030 0.52 0.015" mass="3.0"/>

      <!-- Y axis: smaller carriage riding along the bridge. Same travel as x;
           the bridge is long enough (0.52 > 0.44 + carriage half) to carry it
           the whole way. -->
      <body name="carriage" pos="0 0 0">
        <joint name="axis_y" type="slide" axis="0 1 0" range="-0.44 0.44"
               damping="6" frictionloss="0.8" armature="0.4"/>
        <geom class="gantry" type="box" size="0.050 0.060 0.015" mass="0.8"
              rgba="0.45 0.48 0.55 1"/>

        <!-- ---------------- THE TOOL: two L brackets, one jaw ----------------
             The gantry's ONLY colliding geometry. Both brackets are 1/4 in stock
             standing on edge, hanging from the carriage underside (z = 0.147)
             down to z = 0.004 (4 mm above the surface); the geoms are centred at
             z = -0.0865 in the carriage frame with half-height 0.0715.

             In each bracket, `_x` is the plate NORMAL to x (it spans y) and `_y`
             the plate normal to y. A bracket's corner is where its two plates
             meet; its arms run from that corner toward the other bracket, so the
             four plates bound a square pocket:

                 x = A corner   <- box ->   x = B corner
                 y = A corner   <- box ->   y = B corner

             All four geom `size`s and `pos`es, and both bodies' masses, are
             rewritten live by ItemSortSim.set_bracket_width; the values here are
             config.BRACKET_WIDTH / bracket_arm_mass() at startup, with the
             corners at config.BRACKET_A_CORNER / BRACKET_B_CORNER. -->

        <!-- Bracket A: fixed. No joint, so it is welded to the carriage -- a
             separate body only so its mass stays separately writable, since the
             width slider is meant to be felt as a mass change on x and y. Its
             corner IS the tool's reference point; the pocket grows away from it
             in +x and +y as the jaw opens. -->
        <body name="bracket_a" pos="0 0 0">
          <geom name="bracket_a_x" type="box" pos="-0.163279 -0.134704 -0.0865"
                size="0.003175 0.025400 0.0715" mass="0.124968"
                rgba="0.85 0.65 0.20 1" friction="0.6 0.005 0.0001"/>
          <geom name="bracket_a_y" type="box" pos="-0.134704 -0.163279 -0.0865"
                size="0.025400 0.003175 0.0715" mass="0.124968"
                rgba="0.85 0.65 0.20 1" friction="0.6 0.005 0.0001"/>
        </body>

        <!-- Bracket B: the moving jaw. Slides along the (1,1) diagonal, which
             MuJoCo normalises, so the joint coordinate is the actuator's stroke
             in metres and it opens the pocket by stroke/sqrt(2) in each of x and
             y (config.jaw_opening). Range is +/-JAW_TRAVEL about a mid-stroke
             zero, matching every other axis here.

             Lighter armature and damping than the slides: this axis moves one
             bracket, not a bridge. -->
        <body name="bracket_b" pos="0 0 0">
          <joint name="axis_jaw" type="slide" axis="1 1 0" range="-0.17 0.17"
                 damping="5" frictionloss="0.6" armature="0.3"/>
          <geom name="bracket_b_x" type="box" pos="0.043071 0.014496 -0.0865"
                size="0.003175 0.025400 0.0715" mass="0.124968"
                rgba="0.90 0.45 0.20 1" friction="0.6 0.005 0.0001"/>
          <geom name="bracket_b_y" type="box" pos="0.014496 0.043071 -0.0865"
                size="0.025400 0.003175 0.0715" mass="0.124968"
                rgba="0.90 0.45 0.20 1" friction="0.6 0.005 0.0001"/>
        </body>
      </body>
    </body>

    <!-- ===================== BOX POOL ===================== -->
    <!-- MuJoCo cannot add a body to a live model, so every box that could ever
         be inserted is declared here up front and parked off-platform. The GUI
         "inserts" one by teleporting a spare onto the surface (ItemSortSim
         .spawn_box) and "clears" by sending them all back. Nothing sits on the
         platform at startup.

         Body names, order and count must match item_sort_config.BOX_NAMES /
         BOX_SLOTS, and each body's `pos` is its staging pose from
         config.box_park_pose -- ItemSortSim re-asserts those on reset, so the
         two only need to agree for a clean first load.

         Footprints and startup masses come from the size classes at the top of
         the file; ItemSortSim.set_box_mass rewrites the masses live. -->
    <body name="small1" pos="-2.70 2.20 0.0135"><freejoint/><geom name="small1_geom" class="small"/></body>
    <body name="small2" pos="-2.25 2.20 0.0135"><freejoint/><geom name="small2_geom" class="small"/></body>
    <body name="small3" pos="-1.80 2.20 0.0135"><freejoint/><geom name="small3_geom" class="small"/></body>
    <body name="small4" pos="-1.35 2.20 0.0135"><freejoint/><geom name="small4_geom" class="small"/></body>
    <body name="small5" pos="-0.90 2.20 0.0135"><freejoint/><geom name="small5_geom" class="small"/></body>
    <body name="small6" pos="-0.45 2.20 0.0135"><freejoint/><geom name="small6_geom" class="small"/></body>

    <body name="medium1" pos="0.00 2.20 0.0135"><freejoint/><geom name="medium1_geom" class="medium"/></body>
    <body name="medium2" pos="0.45 2.20 0.0135"><freejoint/><geom name="medium2_geom" class="medium"/></body>
    <body name="medium3" pos="0.90 2.20 0.0135"><freejoint/><geom name="medium3_geom" class="medium"/></body>
    <body name="medium4" pos="1.35 2.20 0.0135"><freejoint/><geom name="medium4_geom" class="medium"/></body>

    <body name="large1" pos="1.80 2.20 0.0135"><freejoint/><geom name="large1_geom" class="large"/></body>
    <body name="large2" pos="2.25 2.20 0.0135"><freejoint/><geom name="large2_geom" class="large"/></body>
    <body name="large3" pos="2.70 2.20 0.0135"><freejoint/><geom name="large3_geom" class="large"/></body>
  </worldbody>

  <!-- Explicit platform <-> box contacts. Left to MuJoCo's default rule the
       coefficient would be the *max* of the two geoms' friction, so the surface
       could never be made more slippery than the boxes; a predefined pair takes
       precedence and pins it exactly. ItemSortSim.set_surface_friction writes
       the two sliding entries of these pairs, which is what makes
       config.SURFACE_FRICTION a live GUI knob.

       Box <-> box, box <-> lip and blade <-> box still use the geom rule. -->
  <contact>
    <pair geom1="platform" geom2="small1_geom"  friction="0.5 0.5 0.005 0.0001 0.0001"/>
    <pair geom1="platform" geom2="small2_geom"  friction="0.5 0.5 0.005 0.0001 0.0001"/>
    <pair geom1="platform" geom2="small3_geom"  friction="0.5 0.5 0.005 0.0001 0.0001"/>
    <pair geom1="platform" geom2="small4_geom"  friction="0.5 0.5 0.005 0.0001 0.0001"/>
    <pair geom1="platform" geom2="small5_geom"  friction="0.5 0.5 0.005 0.0001 0.0001"/>
    <pair geom1="platform" geom2="small6_geom"  friction="0.5 0.5 0.005 0.0001 0.0001"/>
    <pair geom1="platform" geom2="medium1_geom" friction="0.5 0.5 0.005 0.0001 0.0001"/>
    <pair geom1="platform" geom2="medium2_geom" friction="0.5 0.5 0.005 0.0001 0.0001"/>
    <pair geom1="platform" geom2="medium3_geom" friction="0.5 0.5 0.005 0.0001 0.0001"/>
    <pair geom1="platform" geom2="medium4_geom" friction="0.5 0.5 0.005 0.0001 0.0001"/>
    <pair geom1="platform" geom2="large1_geom"  friction="0.5 0.5 0.005 0.0001 0.0001"/>
    <pair geom1="platform" geom2="large2_geom"  friction="0.5 0.5 0.005 0.0001 0.0001"/>
    <pair geom1="platform" geom2="large3_geom"  friction="0.5 0.5 0.005 0.0001 0.0001"/>
  </contact>

  <!-- Actuator order defines the axis vector used everywhere (AXIS_NAMES):
       [x, y, jaw]. N on all three slides; ctrlrange must match
       config.MAX_FORCE. -->
  <actuator>
    <motor name="axis_x"   joint="axis_x"   ctrlrange="-120 120"/>
    <motor name="axis_y"   joint="axis_y"   ctrlrange="-80 80"/>
    <motor name="axis_jaw" joint="axis_jaw" ctrlrange="-60 60"/>
  </actuator>

  <!-- No <keyframe>: the nominal initial state is "gantry centred, jaw at
       mid-stroke, box pool parked", which is what the bodies above already
       declare, and
       ItemSortSim.reset_state parks every box explicitly anyway. A keyframe
       would mean maintaining all 13 box poses in a second place. -->
</mujoco>
